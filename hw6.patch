@@ -0,0 +1,15 @@
+# ШАБЛОН. НЕ коммить реальные значения.
+#   cp k8s/secret.example.yaml k8s/secret.yaml   # secret.yaml уже в .gitignore
+# и подставь свои значения, затем: kubectl apply -f k8s/secret.yaml
+#
+# Один Secret питает и Postgres (POSTGRES_USER/POSTGRES_PASSWORD), и backend
+# (DB_USER/DB_PASSWORD) — значения берутся из ОДНИХ ключей, поэтому логин/пароль
+# базы и клиента всегда совпадают by design.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: backend-secret
+type: Opaque
+stringData:
+  DB_USER: "todo"
+  DB_PASSWORD: "CHANGE_ME_сильный_пароль"
