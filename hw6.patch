+# Несекретная конфигурация backend. Можно и нужно коммитить в git — паролей тут нет.
+# Postgres берёт имя базы (DB_NAME) отсюда; логин/пароль — из Secret (см. secret.example.yaml).
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: backend-config
+data:
+  NODE_ENV: "production"
+  PORT: "3000"
+  # DB_HOST — это имя Service Postgres в кластере. DNS кластера резолвит его в Pod.
+  DB_HOST: "postgres"
+  DB_PORT: "5432"
+  DB_NAME: "todo"
+  # Фронт и API живут на одном origin (https://<домен> и https://<домен>/api),
+  # поэтому CORS фактически не нужен. Приложение читает переменную — оставляем пустой.
+  CORS_ORIGIN: ""
diff --git a/k8s/dockerhub-secret.example.yaml b/k8s/dockerhub-secret.example.yaml
new file mode 100644
index 0000000..8b02a57
--- /dev/null
+++ b/k8s/dockerhub-secret.example.yaml
@@ -0,0 +1,19 @@
+# ШАБЛОН для доступа к приватному образу на Docker Hub. НЕ коммить реальный токен.
+#   cp k8s/dockerhub-secret.example.yaml k8s/dockerhub-secret.yaml   # уже в .gitignore
+# Токен: Docker Hub → Account Settings → Security → New Access Token → права Read-only.
+# Токены Docker Hub начинаются с dckr_pat_ — это не пароль от аккаунта.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: dockerhub-cred
+type: kubernetes.io/dockerconfigjson
+stringData:
+  .dockerconfigjson: |
+    {
+      "auths": {
+        "https://index.docker.io/v1/": {
+          "username": "ВАШ_ЛОГИН",
+          "password": "dckr_pat_ВАШ_ТОКЕН"
+        }
+      }
+    }
