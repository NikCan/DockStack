diff --git a/k8s/ingress.yaml b/k8s/ingress.yaml
new file mode 100644
index 0000000..1363093
--- /dev/null
+++ b/k8s/ingress.yaml
@@ -0,0 +1,44 @@
+# Единая точка входа: ingress-nginx принимает 80/443, маршрутизирует по пути.
+# Замени ВАШ_ДОМЕН на свой домен (тот же, что был в hw3).
+#
+#   /      → frontend (React-статика)
+#   /api   → backend  (NestJS)
+#
+# Тонкость: у backend НЕТ префикса /api (роуты живут в корне: /todos, /health,
+# /ready, /metrics, /test/reset). Поэтому /api надо СРЕЗАТЬ перед проксированием —
+# это делает аннотация rewrite-target вместе с regex-группами в path:
+#   path /api(/|$)(.*)  → группа $2 = всё после /api  → rewrite-target /$2
+#   /api/todos → /todos,  /api/health → /health,  /api → /
+# Для фронта путь /()(.*) даёт $2 = весь путь → /$2 = тот же путь (identity).
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: app-ingress
+  annotations:
+    nginx.ingress.kubernetes.io/rewrite-target: /$2
+    nginx.ingress.kubernetes.io/proxy-body-size: "10m"
+    cert-manager.io/cluster-issuer: letsencrypt-prod
+spec:
+  ingressClassName: nginx
+  tls:
+    - hosts:
+        - ВАШ_ДОМЕН
+      secretName: app-tls           # сюда cert-manager положит сертификат Let's Encrypt
+  rules:
+    - host: ВАШ_ДОМЕН
+      http:
+        paths:
+          - path: /api(/|$)(.*)
+            pathType: ImplementationSpecific
+            backend:
+              service:
+                name: backend
+                port:
+                  number: 80
+          - path: /()(.*)
+            pathType: ImplementationSpecific
+            backend:
+              service:
+                name: frontend
+                port:
+                  number: 80
diff --git a/k8s/optional/README.md b/k8s/optional/README.md
new file mode 100644
index 0000000..ffd249f
--- /dev/null
+++ b/k8s/optional/README.md
@@ -0,0 +1,13 @@
+# k8s/optional — необязательные манифесты (soft, вне обязательного DoD)
+
+Эти манифесты **не** применяются командой `kubectl apply -f k8s/` (она нерекурсивна и
+в подпапки не заходит). Применяй их вручную и только после установки нужных
+зависимостей — иначе `kubectl apply` упадёт на отсутствующих CRD/компонентах.
+
+| Файл | Зависимость | Урок |
+|---|---|---|
+| `backend-hpa.yaml` | Metrics Server (`kubectl top pods` работает) | HPA |
+| `backend-servicemonitor.yaml` | CRD `ServiceMonitor` из `kube-prometheus-stack` | Мониторинг |
+
+Порядок и подробности — в self-study по мониторингу и автоскейлингу
+(`full-course/hometasks/06/03-k8s-monitoring-scaling-self-study.mdx`).
diff --git a/k8s/optional/backend-hpa.yaml b/k8s/optional/backend-hpa.yaml
new file mode 100644
index 0000000..cde0d6e
--- /dev/null
+++ b/k8s/optional/backend-hpa.yaml
@@ -0,0 +1,24 @@
+# SOFT (не входит в обязательный DoD). Требует установленного Metrics Server
+# (ставится вместе с kube-prometheus-stack — см. self-study по мониторингу).
+# Лежит в optional/, чтобы `kubectl apply -f k8s/` (нерекурсивный) его не подхватывал.
+#
+# HPA считает загрузку ОТНОСИТЕЛЬНО resources.requests в backend.yaml — без requests
+# работать не будет. При росте CPU выше target добавляет реплики, при спаде — убирает.
+apiVersion: autoscaling/v2
+kind: HorizontalPodAutoscaler
+metadata:
+  name: backend-hpa
+spec:
+  scaleTargetRef:
+    apiVersion: apps/v1
+    kind: Deployment
+    name: backend
+  minReplicas: 2
+  maxReplicas: 6
+  metrics:
+    - type: Resource
+      resource:
+        name: cpu
+        target:
+          type: Utilization
+          averageUtilization: 70
diff --git a/k8s/optional/backend-servicemonitor.yaml b/k8s/optional/backend-servicemonitor.yaml
new file mode 100644
index 0000000..f53506e
--- /dev/null
+++ b/k8s/optional/backend-servicemonitor.yaml
@@ -0,0 +1,22 @@
+# SOFT (не входит в обязательный DoD). Требует CRD ServiceMonitor из
+# kube-prometheus-stack — без него `kubectl apply` упадёт "no matches for kind
+# ServiceMonitor". Поэтому файл в optional/, а не в основном k8s/.
+#
+# ServiceMonitor — kubernetes-нативная замена статического prometheus.yml: говорит
+# Prometheus-operator'у собирать метрики с Service backend по порту http, путь /metrics.
+apiVersion: monitoring.coreos.com/v1
+kind: ServiceMonitor
+metadata:
+  name: backend-monitor
+  labels:
+    # Должен совпадать с именем Helm-release kube-prometheus-stack — по этому лейблу
+    # operator находит «свои» ServiceMonitor-ы. Иначе таргет не появится.
+    release: kube-prometheus-stack
+spec:
+  selector:
+    matchLabels:
+      app: backend
+  endpoints:
+    - port: http
+      path: /metrics
+      interval: 15s
diff --git a/k8s/postgres.yaml b/k8s/postgres.yaml
new file mode 100644
index 0000000..02c609b
--- /dev/null
+++ b/k8s/postgres.yaml
@@ -0,0 +1,91 @@
+# Postgres как StatefulSet — stateful-нагрузке нужны стабильное имя (postgres-0)
+# и собственный том, переживающий пересоздание Pod-а.
+apiVersion: apps/v1
+kind: StatefulSet
+metadata:
+  name: postgres
+spec:
+  serviceName: postgres        # ссылка на Headless Service ниже — даёт стабильный DNS
+  replicas: 1
+  selector:
+    matchLabels:
+      app: postgres
+  template:
+    metadata:
+      labels:
+        app: postgres
+    spec:
+      containers:
+        - name: postgres
+          image: postgres:16-alpine
+          ports:
+            - containerPort: 5432
+          env:
+            - name: POSTGRES_DB
+              valueFrom:
+                configMapKeyRef:
+                  name: backend-config
+                  key: DB_NAME
+            - name: POSTGRES_USER
+              valueFrom:
+                secretKeyRef:
+                  name: backend-secret
+                  key: DB_USER
+            - name: POSTGRES_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: backend-secret
+                  key: DB_PASSWORD
+            # Postgres требует чистую директорию при init; том может содержать
+            # служебные файлы (lost+found) — уводим данные в подпапку pgdata.
+            - name: PGDATA
+              value: /var/lib/postgresql/data/pgdata
+          volumeMounts:
+            - name: data
+              mountPath: /var/lib/postgresql/data
+          resources:
+            requests:
+              cpu: "100m"
+              memory: "128Mi"
+            limits:
+              cpu: "250m"
+              memory: "256Mi"
+          # readiness через pg_isready — Pod готов, только когда БД принимает подключения.
+          readinessProbe:
+            exec:
+              command:
+                - sh
+                - -c
+                - pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
+            initialDelaySeconds: 5
+            periodSeconds: 10
+          # liveness — простая проверка, что порт 5432 слушается.
+          livenessProbe:
+            tcpSocket:
+              port: 5432
+            initialDelaySeconds: 15
+            periodSeconds: 20
+  # volumeClaimTemplates — StatefulSet сам создаст PVC data-postgres-0 (StorageClass
+  # local-path в k3s выдаст под него PV как директорию на ноде). Отдельный PVC-файл не нужен.
+  volumeClaimTemplates:
+    - metadata:
+        name: data
+      spec:
+        accessModes: ["ReadWriteOnce"]
+        resources:
+          requests:
+            storage: 1Gi
+---
+# Headless Service (clusterIP: None) — обязателен для StatefulSet: даёт Pod-у
+# стабильное DNS-имя. Backend обращается к базе просто по имени `postgres`.
+apiVersion: v1
+kind: Service
+metadata:
+  name: postgres
+spec:
+  selector:
+    app: postgres
+  ports:
+    - port: 5432
+      targetPort: 5432
+  clusterIP: None
diff --git a/k8s/secret.example.yaml b/k8s/secret.example.yaml
new file mode 100644
index 0000000..a99f0e1
--- /dev/null
