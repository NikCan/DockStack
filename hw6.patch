+# Runtime-конфиг приложения (лимит maxTodos). Backend читает его в рантайме из
+# /app/config/app.json при создании todo. В docker-compose (hw2) он монтировался
+# read-only из папки app-config/; в Kubernetes ту же роль играет этот ConfigMap,
+# смонтированный как файл в backend-е (см. volumeMounts в k8s/backend.yaml).
+#
+# Хочешь другой лимит — поменяй maxTodos здесь и переприменяй ConfigMap
+# (kubectl apply -f k8s/app-config.yaml), затем перезапусти backend
+# (kubectl rollout restart deployment/backend), чтобы подхватить новый файл.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: backend-appconfig
+data:
+  app.json: |
+    {
+      "maxTodos": 5
+    }
diff --git a/k8s/backend.yaml b/k8s/backend.yaml
new file mode 100644
index 0000000..c95e3be
--- /dev/null
+++ b/k8s/backend.yaml
@@ -0,0 +1,97 @@
+# Backend (NestJS) — stateless, поэтому Deployment (в отличие от базы).
+#
+# ВАЖНО: image и APP_VERSION — плейсхолдеры ${IMAGE}/${APP_VERSION}. Применять
+# файл напрямую нельзя — Pod уйдёт в ImagePullBackOff на литеральной строке "${IMAGE}".
+# Деплой только через envsubst, который подставит переменные окружения:
+#   export IMAGE=ВАШ_ЛОГИН/todo-back:latest APP_VERSION=manual
+#   envsubst < k8s/backend.yaml | kubectl apply -f -
+# В CI те же переменные приходят из шага build (конкретный sha-тег) — см. deploy-k8s.yml.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: backend
+  labels:
+    app: backend
+spec:
+  replicas: 2
+  selector:
+    matchLabels:
+      app: backend
+  template:
+    metadata:
+      labels:
+        app: backend
+    spec:
+      imagePullSecrets:
+        - name: dockerhub-cred
+      containers:
+        - name: backend
+          image: ${IMAGE}
+          ports:
+            - containerPort: 3000
+          envFrom:
+            - configMapRef:
+                name: backend-config
+            - secretRef:
+                name: backend-secret
+          env:
+            # APP_VERSION отдаётся на /health — smoke-проверка и AI-агент сверяют
+            # его с sha текущего коммита (тот же контракт, что в hw4/hw5).
+            - name: APP_VERSION
+              value: "${APP_VERSION}"
+          resources:
+            requests:
+              cpu: "100m"      # HPA (soft) считает загрузку относительно request
+              memory: "128Mi"
+            limits:
+              cpu: "300m"
+              memory: "256Mi"
+          # startupProbe даёт приложению время подняться и подключиться к БД,
+          # прежде чем включатся liveness/readiness (до 60с: 20 × 3с).
+          startupProbe:
+            httpGet:
+              path: /health
+              port: 3000
+            failureThreshold: 20
+            periodSeconds: 3
+          # liveness — «процесс жив». Провал → перезапуск контейнера. Без похода в БД.
+          livenessProbe:
+            httpGet:
+              path: /health
+              port: 3000
+            periodSeconds: 15
+            failureThreshold: 3
+          # readiness — «готов принять трафик». /ready проверяет доступность БД.
+          # Провал → Pod убирается из endpoints Service (трафик не идёт), без рестарта.
+          readinessProbe:
+            httpGet:
+              path: /ready
+              port: 3000
+            periodSeconds: 10
+            failureThreshold: 3
+          # Runtime-конфиг (maxTodos) — backend читает /app/config/app.json при
+          # создании todo. Монтируем ConfigMap backend-appconfig как файл, read-only
+          # (в docker-compose это был bind-mount app-config/ → /app/config:ro).
+          volumeMounts:
+            - name: app-config
+              mountPath: /app/config
+              readOnly: true
+      volumes:
+        - name: app-config
+          configMap:
+            name: backend-appconfig
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: backend
+  labels:
+    app: backend
+spec:
+  selector:
+    app: backend
+  ports:
+    - name: http          # именованный порт нужен ServiceMonitor (см. k8s/optional/)
+      port: 80
+      targetPort: 3000
+  type: ClusterIP
diff --git a/k8s/cluster-issuer.yaml b/k8s/cluster-issuer.yaml
new file mode 100644
index 0000000..cbfc480
--- /dev/null
+++ b/k8s/cluster-issuer.yaml
@@ -0,0 +1,18 @@
+# ClusterIssuer — источник TLS-сертификатов для всего кластера через Let's Encrypt.
+# cert-manager видит аннотацию cert-manager.io/cluster-issuer на Ingress, делает
+# ACME HTTP-01 challenge и кладёт выданный сертификат в Secret app-tls.
+# Замени ВАШ_EMAIL — на него Let's Encrypt шлёт уведомления об истечении.
+apiVersion: cert-manager.io/v1
+kind: ClusterIssuer
+metadata:
+  name: letsencrypt-prod
+spec:
+  acme:
+    server: https://acme-v02.api.letsencrypt.org/directory
+    email: ВАШ_EMAIL
+    privateKeySecretRef:
+      name: letsencrypt-prod-key
+    solvers:
+      - http01:
+          ingress:
+            ingressClassName: nginx
